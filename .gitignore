# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# aimake local state and generated outputs
.aimake/
aimake.lock

# Project build outputs (when running examples or local init)
examples/**/build/
/build/

# Local project scaffold from `aimake init` at repo root (use examples/rag/ instead)
/aimake.yaml
/data/
/prompts/
/src/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Frontend apps (clone repo; not part of the PyPI package)
dashboard/node_modules/
dashboard/.next/
website/node_modules/
website/.next/
extension/node_modules/
extension/out/
extension/*.vsix
